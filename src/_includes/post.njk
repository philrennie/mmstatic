{% extends "base.njk" %}
{% set bodyClass = "page page-post" %}
{% block main %}
{%- set list = collections[section] %}
{%- set n = list | neighbours(page.url) %}
<article class="post wrap">
  <h1 class="page-title">{{ title }}{% if score %} - {{ score }}/5{% endif %}</h1>
  {%- if draft %}<p class="draft-badge">Draft – not visible on the live site</p>{% endif %}
  <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time></p>
  <div class="post-body prose{% if image %} image-{{ imagePosition or 'left' }}{% endif %}">
    {%- if image %}
    <figure class="post-image"><img src="{{ image }}" alt="" sizes="(min-width: 40rem) 400px, 100vw" loading="eager"></figure>
    {%- endif %}
    {{ content | safe }}
    {%- set videoUrl = video %}{% set videoTitle = title %}
    {% include "partials/video.njk" %}
  </div>
  <nav class="post-nav" aria-label="More {{ section }}">
    <div>{% if n.newer %}<a href="{{ n.newer.url }}" rel="next">&laquo; {{ n.newer.data.title }}</a>{% endif %}</div>
    <div class="post-nav-index"><a href="/{{ section }}/">Return to list</a></div>
    <div>{% if n.older %}<a href="{{ n.older.url }}" rel="prev">{{ n.older.data.title }} &raquo;</a>{% endif %}</div>
  </nav>
</article>
{%- if section == "reviews" and collections.reviews.length > 1 %}
<section class="band latest">
  <div class="wrap">
    <h2 class="section-heading">Latest Reviews</h2>
    <div class="cards">
      {%- for post in collections.reviews | without(page.url) | head(3) %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}
{% endblock %}
