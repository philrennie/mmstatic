<footer class="site-footer">
  <div class="wrap">
    <nav aria-label="Footer"><a href="/sitemap/">sitemap</a></nav>
  </div>
</footer>
{%- set labels = { linkedin: "LinkedIn", instagram: "Instagram", facebook: "Facebook", x: "X", youtube: "YouTube", vimeo: "Vimeo" } %}
<aside class="social" aria-label="Social links">
  <ul>
    {%- for key, url in site.social %}{% if url %}
    <li><a href="{{ url }}" class="social-{{ key }}" rel="me noopener" target="_blank"><span>{{ labels[key] or key }}</span></a></li>
    {%- endif %}{% endfor %}
  </ul>
</aside>
