<div class="wrap listing">
  <h1 class="page-title">{{ title }}</h1>
  {%- if pagination.pageNumber == 0 and site.sections[listSection].intro %}
  <div class="prose listing-intro">{{ site.sections[listSection].intro | safe }}</div>
  {%- endif %}
  {%- for post in posts %}
  <article class="list-item">
    <h2><a href="{{ post.url }}">{{ post.data.title }}{% if post.data.score %} - {{ post.data.score }}/5{% endif %}</a>{% if post.data.draft %} <span class="draft-badge">Draft</span>{% endif %}</h2>
    <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | longDate }}</time></p>
    {%- if post.data.image %}
    <a class="list-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.image }}" alt="" sizes="(min-width: 44rem) 630px, 100vw"></a>
    {%- endif %}
    <p class="list-excerpt">{{ post.content | excerpt(255) }}</p>
    <p><a class="read-more" href="{{ post.url }}">Read more<span class="visually-hidden"> about {{ post.data.title }}</span></a></p>
  </article>
  {%- else %}
  <p>Sorry, there's nothing here yet.</p>
  {%- endfor %}
  {%- if pagination.pages.length > 1 %}
  <nav class="pager" aria-label="Pages">
    {%- if pagination.href.previous %}<a class="read-more" href="{{ pagination.href.previous }}">&laquo; Newer</a>{% else %}<span></span>{% endif %}
    <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {%- if pagination.href.next %}<a class="read-more" href="{{ pagination.href.next }}">Older &raquo;</a>{% else %}<span></span>{% endif %}
  </nav>
  {%- endif %}
</div>
