---
permalink: /
---
{% extends "base.njk" %}
{% set bodyClass = "page page-home" %}
{% block head %}
  <link rel="preconnect" href="https://challenges.cloudflare.com">
{% endblock %}
{% block main %}
<section class="hero" style="--title-colour: {{ site.hero.colour or '#fff' }}">
  {%- if site.hero.image %}
  <img class="hero-image" src="{{ site.hero.image }}" alt="" sizes="100vw" loading="eager" fetchpriority="high">
  {%- endif %}
  <div class="wrap hero-inner">
    <h1 class="hero-title"><span class="visually-hidden">{{ site.title }} – </span>{{ site.hero.heading | nl2br | safe }}</h1>
  </div>
</section>

{%- if site.showreel.video %}
<section class="band showreel" id="showreel" style="--band-bg: {{ site.showreel.background }}; --band-fg: {{ site.showreel.colour }}">
  <div class="wrap">
    <h2 class="section-heading">{{ site.showreel.heading }}</h2>
    <div class="showreel-player">
      {%- set videoUrl = site.showreel.video %}{% set videoTitle = site.showreel.title %}
      {% include "partials/video.njk" %}
    </div>
  </div>
</section>
{%- endif %}

<section class="bio" id="bio">
  {%- if site.bio.image %}
  <img class="bio-image" src="{{ site.bio.image }}" alt="Mark Minors" sizes="100vw">
  {%- endif %}
  <div class="wrap bio-inner">
    <div class="bio-panel prose">
      <h2 class="section-heading">{{ site.bio.heading }}</h2>
      {{ site.bio.text | safe }}
    </div>
  </div>
</section>

{%- if collections.latest.length %}
<section class="band band-black latest" id="latest">
  <div class="wrap">
    <h2 class="section-heading">Latest posts</h2>
    <div class="cards">
      {%- for post in collections.latest | head(3) %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="band contact" id="contact" style="--band-bg: {{ site.contact.background }}; --band-fg: {{ site.contact.colour }}">
  <div class="wrap contact-grid">
    <div class="contact-text prose">
      <h2 class="section-heading">{{ site.contact.heading }}</h2>
      {{ site.contact.text | safe }}
    </div>
    {% include "partials/contact-form.njk" %}
  </div>
</section>
{% endblock %}
{% block scripts %}
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script src="/assets/js/contact.js" type="module"></script>
{% endblock %}
